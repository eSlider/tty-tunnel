# tty-tunnel configuration.
# `make up` copies this file to .env on first run, filling in PUID/PGID,
# SSH_USER and HOST_SSH_DIR for the current user. .env is gitignored and also
# receives the generated Termix admin password.

# --- host identity ---------------------------------------------------------
PUID=1000
PGID=1000
SSH_USER=change-me
# Where the host's authorized_keys lives (mounted read-write once, by bootstrap).
HOST_SSH_DIR=./var/host-ssh

# --- forwarded service (inside the Compose network) ------------------------
PORT=8080
TARGET_HOST=termix
TARGET_PROTO=http

# --- Termix ----------------------------------------------------------------
TERMIX_LOCAL_PORT=8080
TERMIX_ADMIN_USER=admin
SSH_HOST=host.docker.internal
SSH_PORT=22
# Append the generated public key to HOST_SSH_DIR/authorized_keys on first run.
AUTHORIZE_SSH_KEY=true

# --- persistent hostname (optional, named tunnel) --------------------------
# TUNNEL_TOKEN=
# TUNNEL_HOSTNAME=

# --- OpenCode in a Termix tab (./tty-tunnel.sh opencode) --------------------
# Set by the CLI; OPENCODE_SSH_PASSWORD is generated on first run.
OPENCODE_ENABLED=0
OPENCODE_SSH_USER=opencode
OPENCODE_SSH_PASSWORD=change-me
OPENCODE_WORKDIR=/workspace
OPENCODE_SEED=true
# Seeded read-only into the container once (your host's OpenCode setup).
OPENCODE_CONFIG_DIR=./var/opencode/seed/config
OPENCODE_DATA_DIR=./var/opencode/seed/data
